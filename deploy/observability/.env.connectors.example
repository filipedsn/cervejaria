# SMTP + alertas Kibana (nao versionar credenciais reais)
#
# Licenca Basic: Kibana usa connector .index -> ES; a API faz poll e envia e-mail.
# Nao e necessario Gold (.webhook/.email bloqueados no Basic local).

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contato@quivercloud.com.br
SMTP_PASS=
SMTP_FROM="Quiver Tap Alertas <contato@quivercloud.com.br>"
OBS_ALERT_EMAIL_TO=contato@quivercloud.com.br

KIBANA_ALERT_ES_URL=http://host.docker.internal:9200
KIBANA_ALERT_ES_INDEX=quiver-tap-alert-events
KIBANA_ALERT_POLL_INTERVAL_MS=30000

# Depois: npm run obs:alert-email
