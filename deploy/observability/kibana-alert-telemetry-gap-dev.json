{
  "name": "quiver-tap-telemetry-gap-dev",
  "tags": [
    "quiver-tap",
    "TAP-96",
    "development"
  ],
  "rule_type_id": ".es-query",
  "consumer": "stackAlerts",
  "schedule": {
    "interval": "1m"
  },
  "enabled": true,
  "params": {
    "index": [
      "metrics-generic.otel-dev*"
    ],
    "timeField": "@timestamp",
    "esQuery": "{\"query\":{\"term\":{\"resource.attributes.service.name\":\"quiver-tap-api-dev\"}}}",
    "size": 1,
    "timeWindowSize": 15,
    "timeWindowUnit": "m",
    "thresholdComparator": "<",
    "threshold": [
      1
    ],
    "aggType": "count",
    "groupBy": "all",
    "searchType": "esQuery",
    "excludeHitsFromPreviousRun": false
  },
  "actions": [],
  "notify_when": "onActionGroupChange"
}
