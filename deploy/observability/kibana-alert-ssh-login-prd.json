{
  "name": "quiver-tap-ssh-login-prd",
  "tags": ["quiver-tap", "observability", "production", "infra", "seguranca", "ssh"],
  "rule_type_id": ".es-query",
  "consumer": "stackAlerts",
  "schedule": { "interval": "1m" },
  "enabled": true,
  "params": {
    "index": ["logs-ssh_auth.otel-infra*"],
    "timeField": "@timestamp",
    "esQuery": "{\"query\":{\"bool\":{\"filter\":[{\"terms\":{\"attributes.ssh.event\":[\"Accepted publickey\",\"Accepted password\"]}}],\"must_not\":[{\"prefix\":{\"attributes.source.address\":\"100.\"}}]}}}",
    "size": 10,
    "timeWindowSize": 2,
    "timeWindowUnit": "m",
    "thresholdComparator": ">",
    "threshold": [0],
    "aggType": "count",
    "groupBy": "all",
    "searchType": "esQuery"
  },
  "actions": [],
  "notify_when": "onActionGroupChange"
}
