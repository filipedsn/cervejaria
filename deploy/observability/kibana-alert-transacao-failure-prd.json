{
  "name": "quiver-tap-transacao-failure-prd",
  "tags": ["quiver-tap", "observability", "production", "functional"],
  "rule_type_id": ".es-query",
  "consumer": "stackAlerts",
  "schedule": { "interval": "5m" },
  "enabled": true,
  "params": {
    "index": ["logs-audit*.otel-prd"],
    "timeField": "@timestamp",
    "esQuery": "{\"query\":{\"bool\":{\"must\":[{\"wildcard\":{\"attributes.event.action\":\"transacao.*\"}},{\"term\":{\"attributes.event.outcome\":\"failure\"}}]}}}",
    "size": 20,
    "timeWindowSize": 15,
    "timeWindowUnit": "m",
    "thresholdComparator": ">",
    "threshold": [0],
    "aggType": "count",
    "groupBy": "all",
    "searchType": "esQuery",
    "excludeHitsFromPreviousRun": true
  },
  "actions": [],
  "notify_when": "onActionGroupChange"
}
