{
  "name": "quiver-tap-api-down",
  "_deprecated": "Substituido por quiver-tap-telemetry-gap-prd/dev + quiver-tap-api-down-prd (uptime). Mantido apenas como referencia.",
  "tags": ["quiver-tap", "observability", "deprecated"],
  "rule_type_id": ".es-query",
  "consumer": "stackAlerts",
  "schedule": { "interval": "5m" },
  "enabled": false,
  "params": {
    "index": ["metrics-generic.otel-default*"],
    "timeField": "@timestamp",
    "esQuery": "{\"query\":{\"bool\":{\"should\":[{\"term\":{\"resource.attributes.service.name\":\"quiver-tap-api-dev\"}},{\"term\":{\"resource.attributes.service.name\":\"quiver-tap-api\"}}],\"minimum_should_match\":1}}}",
    "size": 100,
    "timeWindowSize": 10,
    "timeWindowUnit": "m",
    "thresholdComparator": "<",
    "threshold": [1],
    "aggType": "count",
    "groupBy": "all",
    "searchType": "esQuery"
  },
  "actions": [],
  "notify_when": "onActionGroupChange"
}
