{
  "name": "quiver-tap-ui-negocio-dev",
  "tags": ["quiver-tap", "observability", "development", "functional", "negocio"],
  "rule_type_id": ".es-query",
  "consumer": "stackAlerts",
  "schedule": { "interval": "5m" },
  "enabled": true,
  "params": {
    "index": ["logs-audit*.otel-dev"],
    "timeField": "@timestamp",
    "esQuery": "{\"query\":{\"bool\":{\"must\":[{\"term\":{\"attributes.event.action\":\"ui.error\"}},{\"term\":{\"attributes.event.outcome\":\"failure\"}},{\"term\":{\"attributes.metadata.handled\":true}},{\"terms\":{\"attributes.metadata.kind\":[\"validation\",\"api_client\"]}}]}}}",
    "size": 20,
    "timeWindowSize": 15,
    "timeWindowUnit": "m",
    "thresholdComparator": ">",
    "threshold": [0],
    "aggType": "count",
    "groupBy": "all",
    "searchType": "esQuery",
    "excludeHitsFromPreviousRun": true
  },
  "actions": [],
  "notify_when": "onActiveAlert"
}
