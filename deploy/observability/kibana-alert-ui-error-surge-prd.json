{
  "name": "quiver-tap-ui-error-surge-prd",
  "tags": [
    "quiver-tap",
    "TAP-160",
    "production",
    "functional"
  ],
  "rule_type_id": ".es-query",
  "consumer": "stackAlerts",
  "schedule": {
    "interval": "5m"
  },
  "enabled": true,
  "params": {
    "index": [
      "logs-audit*.otel-prd"
    ],
    "timeField": "@timestamp",
    "esQuery": "{\"query\":{\"bool\":{\"filter\":[{\"term\":{\"attributes.event.action\":\"ui.error\"}}]}}}",
    "size": 10,
    "timeWindowSize": 10,
    "timeWindowUnit": "m",
    "thresholdComparator": ">",
    "threshold": [
      5
    ],
    "aggType": "count",
    "groupBy": "top",
    "termField": "attributes.ui.route",
    "termSize": 10,
    "searchType": "esQuery",
    "excludeHitsFromPreviousRun": false
  },
  "actions": [],
  "notify_when": "onActionGroupChange"
}
