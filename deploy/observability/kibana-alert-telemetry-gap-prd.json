{
  "name": "quiver-tap-telemetry-gap-prd",
  "tags": ["quiver-tap", "observability", "production"],
  "rule_type_id": ".es-query",
  "consumer": "stackAlerts",
  "schedule": { "interval": "5m" },
  "enabled": true,
  "params": {
    "index": ["metrics-generic.otel-prd*"],
    "timeField": "@timestamp",
    "esQuery": "{\"query\":{\"bool\":{\"must\":[{\"term\":{\"resource.attributes.service.name\":\"quiver-tap-api\"}},{\"term\":{\"resource.attributes.deployment.environment.name\":\"production\"}}]}}}",
    "size": 100,
    "timeWindowSize": 15,
    "timeWindowUnit": "m",
    "thresholdComparator": "<",
    "threshold": [1],
    "aggType": "count",
    "groupBy": "all",
    "searchType": "esQuery",
    "excludeHitsFromPreviousRun": true
  },
  "actions": [],
  "notify_when": "onActionGroupChange"
}
