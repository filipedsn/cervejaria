{
  "name": "quiver-tap-public-ready-down-dev",
  "tags": ["quiver-tap", "observability", "development", "healthcheck", "outside-in"],
  "rule_type_id": ".es-query",
  "consumer": "stackAlerts",
  "schedule": { "interval": "1m" },
  "enabled": true,
  "params": {
    "index": ["metrics-httpcheckreceiver.otel-infra*"],
    "timeField": "@timestamp",
    "esQuery": "{\"query\":{\"bool\":{\"must\":[{\"wildcard\":{\"attributes.http.url\":\"*tapdev.quivercloud.com.br/api/ready*\"}}],\"must_not\":[{\"term\":{\"attributes.http.status_code\":200}}]}}}",
    "size": 10,
    "timeWindowSize": 5,
    "timeWindowUnit": "m",
    "thresholdComparator": ">",
    "threshold": [1],
    "aggType": "count",
    "groupBy": "all",
    "searchType": "esQuery"
  },
  "actions": [],
  "notify_when": "onActionGroupChange"
}
