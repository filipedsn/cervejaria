OPS_PANEL_PORT=3099
# GITHUB_REPO=filipedsn/cervejaria
# Host do ~/.ssh/config com a chave só leitura do VPS (forced command quiver-tap-ops-report).
# Vazio: o cartão Produção usa só os endpoints públicos.
# OPS_VPS_SSH_HOST=
# Host do ~/.ssh/config com a chave restrita a baixar/apagar backups (forced command
# quiver-tap-backup-files). Vazio: o painel só lista os backups.
# OPS_BACKUP_SSH_HOST=
# Pasta onde os backups baixados são gravados (padrão: Downloads do usuário).
# OPS_BACKUP_DOWNLOAD_DIR=
