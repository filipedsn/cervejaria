# Copie para support-agent/.env (gitignored).
# Credenciais do Elasticsearch tambem sao lidas de deploy/observability/.env.observability,
# entao normalmente basta deixar as linhas de ES comentadas aqui.

# --- Modo de operacao ---
# Fase 2: sombra abre apenas Issues e nunca chama o fixer. Mantenha true por 1-2 semanas.
SUPPORT_AGENT_SHADOW=true
# Fase 3: kill switch do fixer. Para a correcao sem parar a triagem.
SUPPORT_AGENT_FIXER_ENABLED=false
# Nao escreve em lugar nenhum — so mostra o que faria. Bom para a primeira execucao.
SUPPORT_AGENT_DRY_RUN=false
SUPPORT_AGENT_POLL_INTERVAL_MS=60000

# --- Elasticsearch ---
# Chave propria do agente (le alertas + logs/traces). Gere com: npm run obs:create-api-keys
# A chave do alert-poller NAO serve: ela nao le logs-*.
# SUPPORT_AGENT_ES_API_KEY=
# SUPPORT_AGENT_ES_URL=http://127.0.0.1:9200
# SUPPORT_AGENT_ALERT_INDEX=quiver-tap-alert-events
# SUPPORT_AGENT_LOG_INDEX=logs-audit*.otel-prd
# SUPPORT_AGENT_KIBANA_URL=http://127.0.0.1:5601

# --- GitHub ---
# Vazio usa o login local do gh (recomendado). O token precisa do escopo workflow
# apenas se o agente for alterar .github/workflows (hoje esta na denylist).
SUPPORT_AGENT_GITHUB_REPO=filipedsn/cervejaria
# SUPPORT_AGENT_GITHUB_TOKEN=
SUPPORT_AGENT_BASE_BRANCH=main

# --- Isolamento ---
# Precisa ficar FORA da arvore do repositorio. O agente recusa iniciar se estiver dentro.
SUPPORT_AGENT_WORKTREE_ROOT=C:\quiver-agent-work

# --- Cursor CLI headless (Fase 3) ---
# Binario do CLI. Use uma service account key para separar o gasto do bot da sua conta.
SUPPORT_AGENT_CURSOR_BIN=cursor-agent
# CURSOR_API_KEY=
# SUPPORT_AGENT_MODEL=
SUPPORT_AGENT_FIX_TIMEOUT_MS=1200000

# --- Circuit breakers (Fase 3) ---
SUPPORT_AGENT_MAX_ATTEMPTS=2
SUPPORT_AGENT_MAX_PRS_PER_DAY=3
# O stream-json do Cursor CLI nao reporta custo (so duration_ms), entao o controle de
# gasto e por numero de execucoes. Vale o menor entre MAX_RUNS_PER_DAY e
# MAX_COST_USD_PER_DAY / EST_COST_USD_PER_RUN. O teto absoluto deve ser um spend limit
# na conta ou na service account key do Cursor.
SUPPORT_AGENT_MAX_RUNS_PER_DAY=6
SUPPORT_AGENT_EST_COST_USD_PER_RUN=1.5
SUPPORT_AGENT_MAX_COST_USD_PER_DAY=10

# --- Metricas (Fase 5) ---
# Collector OTLP local. Vazio desliga a exportacao.
SUPPORT_AGENT_OTLP_ENDPOINT=http://127.0.0.1:4318
SUPPORT_AGENT_ENV=prd
