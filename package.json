{
  "name": "cervejaria-movel",
  "version": "1.0.0",
  "private": true,
  "description": "PWA para cervejarias móveis - comandas, pagamentos e ranking",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:start": "powershell -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File scripts/dev/supervisor.ps1 -Detached",
    "dev:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/status-dev.ps1",
    "dev:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/stop-dev.ps1",
    "restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restart-dev.ps1",
    "prod:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/install-autostart.ps1",
    "prod:install-user": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/install-autostart.ps1 -UserOnly",
    "prod:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/status.ps1",
    "prod:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/backup-db.ps1",
    "db:sync-prod-to-dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/sync-prod-to-dev.ps1",
    "db:backfill:dev": "npm run db:backfill-cliente-stats --prefix backend",
    "prod:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/deploy.ps1",
    "prod:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/restart-api.ps1",
    "prod:ensure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/ensure-running.ps1",
    "prod:fix-flickering": "scripts\\prod\\fix-flickering.cmd",
    "prod:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/stop-all.ps1",
    "prod:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/uninstall-autostart.ps1",
    "build": "npm run build --prefix frontend && npm run build --prefix backend",
    "ci:frontend": "npm run build:deploy --prefix frontend",
    "ci:backend": "npm run build:deploy --prefix backend",
    "ci:validate": "npm run ci:frontend && cd backend && npx prisma generate && npx prisma validate",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:setup:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-setup-dev.ps1",
    "db:create-env-users": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-create-env-users.ps1",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:migrate:prod": "npm run db:migrate:prod --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "qa:test": "npm run qa:test --prefix backend",
    "manual:pdf": "node scripts/generate-manual-pdf.mjs",
    "obs:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/observability/up.ps1",
    "obs:kibana": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/observability/setup-kibana.ps1",
    "obs:configure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/observability/configure-kibana.ps1",
    "ops:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/start-ops-panel.ps1",
    "ops:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/restart-ops-panel.ps1",
    "ops:open": "start http://127.0.0.1:3099"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright": "^1.50.1"
  }
}
