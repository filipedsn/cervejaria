{
  "name": "cervejaria-movel",
  "version": "1.0.0",
  "private": true,
  "description": "PWA para cervejarias mÃ³veis - comandas, pagamentos e ranking",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:start": "powershell -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File scripts/dev/supervisor.ps1 -Detached",
    "dev:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/status-dev.ps1",
    "dev:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/stop-dev.ps1",
    "prisma:generate:unlocked": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/prisma-generate-unlocked.ps1",
    "restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restart-dev.ps1",
    "prod:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/install-autostart.ps1",
    "prod:install-user": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/install-autostart.ps1 -UserOnly",
    "prod:repair-autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/install-autostart.ps1 -RepairTasksOnly",
    "prod:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/status.ps1",
    "prod:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/backup-db.ps1",
    "db:sync-prod-to-dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/sync-prod-to-dev.ps1",
    "db:backfill:dev": "npm run db:backfill-cliente-stats --prefix backend",
    "prod:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/deploy.ps1",
    "prod:preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/deploy.ps1 -PreflightOnly",
    "prod:ready": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/prod-ready.ps1",
    "prod:rollback": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/rollback.ps1",
    "prod:materialize-runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/materialize-prod-runtime.ps1",
    "prod:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/restart-api.ps1",
    "prod:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/verify-prod-artifacts.ps1",
    "prod:ensure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/ensure-running.ps1",
    "prod:fix-flickering": "scripts\\prod\\fix-flickering.cmd",
    "prod:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/stop-all.ps1",
    "prod:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/uninstall-autostart.ps1",
    "build": "npm run build --prefix frontend && npm run build --prefix backend",
    "ci:frontend": "npm run build:deploy --prefix frontend",
    "ci:backend": "npm run build:deploy --prefix backend",
    "ci:validate": "npm run ci:frontend && cd backend && npx prisma generate && npx prisma validate",
    "db:up": "docker compose up -d postgres postgres-dev",
    "db:up:prod": "docker compose up -d postgres",
    "db:up:dev": "docker compose up -d postgres-dev",
    "db:down": "docker compose stop postgres-dev",
    "db:down:all": "docker compose down",
    "db:cleanup-dev-from-prod": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db/drop-dev-from-prod.ps1",
    "db:setup:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-setup-dev.ps1",
    "db:reset:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db/reset-dev.ps1",
    "db:create-env-users": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-create-env-users.ps1",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:migrate:prod": "npm run db:migrate:prod --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "qa:test": "npm run qa:test --prefix backend",
    "qa:teardown": "npm run qa:teardown --prefix backend",
    "test:unit": "npm run test:unit --prefix backend",
    "ops:test": "npm run test:unit --prefix ops-panel",
    "qa:validate": "npm run test:unit --prefix backend && npm run qa:test --prefix backend && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "manual:pdf": "node scripts/generate-manual-pdf.mjs",
    "obs:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/observability/up.ps1",
    "obs:kibana": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/observability/setup-kibana.ps1",
    "obs:configure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/observability/configure-kibana.ps1",
    "obs:fix-es-replicas": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/observability/fix-es-replicas.ps1",
    "obs:fix-tcpcheck": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/observability/fix-tcpcheck-ds.ps1",
    "obs:ilm": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/observability/setup-ilm.ps1",
    "obs:report-4xx": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/observability/report-4xx.ps1",
    "obs:budget": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/observability/report-budget.ps1",
    "obs:index-defaults": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/observability/setup-index-defaults.ps1",
    "obs:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/observability/verify-segregation.ps1",
    "obs:connectors": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/observability/setup-connectors.ps1",
    "obs:alert-email": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/observability/setup-alert-email.ps1",
    "obs:webhook": "npm run obs:alert-email",
    "obs:test-webhook": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/observability/test-webhook.ps1",
    "obs:test-telegram": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/observability/test-telegram.ps1",
    "obs:test-telegram-example": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/observability/test-telegram-example.ps1",
    "obs:report-slo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/observability/report-slo.ps1",
    "obs:create-api-keys": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/observability/create-elastic-api-keys.ps1",
    "alert-poller:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/start-alert-poller.ps1",
    "alert-poller:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/stop-alert-poller.ps1",
    "agent:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/support-agent/start.ps1",
    "agent:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/support-agent/stop.ps1",
    "agent:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/support-agent/status.ps1",
    "agent:triage": "npm run triage --prefix support-agent",
    "agent:preview": "npm run preview --prefix support-agent",
    "agent:report": "npm run report --prefix support-agent",
    "agent:probe": "npm run probe --prefix support-agent",
    "agent:test": "npm run test:unit --prefix support-agent",
    "agent:fixer:off": "npm run fixer:switch --prefix support-agent -- off",
    "agent:fixer:on": "npm run fixer:switch --prefix support-agent -- on",
    "agent:fixer:status": "npm run fixer:switch --prefix support-agent -- status",
    "agent:review": "npm run review --prefix support-agent",
    "ops:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/status-ops-panel.ps1",
    "ops:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/stop-ops-panel.ps1",
    "ops:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/start-ops-panel.ps1",
    "ops:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/restart-ops-panel.ps1",
    "ops:open": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/open-ops-panel.ps1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "concurrently": "^9.1.2",
    "playwright": "^1.50.1"
  }
}
