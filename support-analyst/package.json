{
  "name": "quiver-tap-support-analyst",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import ../scripts/node24-tsx-host.mjs --import tsx --test test/*.test.ts",
    "validate": "npm run typecheck && npm run test && npm run build",
    "analyst:validate": "npm run validate",
    "dev-smoke": "tsx src/index.ts --dev-smoke",
    "incident-replay": "tsx src/index.ts --incident-replay",
    "dossier-replay": "node --import ../scripts/node24-tsx-host.mjs --import tsx src/index.ts --dossier-replay",
    "feedback": "tsx src/index.ts --feedback",
    "analyst:llm-benchmark": "tsx src/llm-benchmark/cli.ts",
    "analyst:llm-smoke": "tsx src/local-llm/cli.ts --smoke",
    "analyst:llm-status": "tsx src/local-llm/cli.ts --status",
    "analyst:quality-run": "tsx src/quality/cli.ts --run",
    "analyst:quality-summary": "tsx src/quality/cli.ts --summary",
    "analyst:health-status": "tsx src/health/cli.ts",
    "analyst:health-check": "tsx src/health/cli.ts",
    "analyst:health-json": "tsx src/health/cli.ts --json",
    "analyst:health-smoke": "tsx src/health/smoke.ts",
    "analyst:pilot-once": "tsx src/index.ts --pilot-once",
    "analyst:pilot-run": "tsx src/index.ts --pilot-run",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
