{
  "name": "quiver-tap-support-analyst",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "validate": "npm run typecheck && npm run test && npm run build",
    "dev-smoke": "tsx src/index.ts --dev-smoke",
    "incident-replay": "tsx src/index.ts --incident-replay",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
