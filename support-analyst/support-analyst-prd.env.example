# Copie para deploy/runtime/support-analyst-prd.env (pasta ignorada pelo Git). Nunca versionar valores.
# A chave vem do G11 (docs/support-analyst/prd-readonly-role.json); a URL e o endereco Tailscale do ES PRD.
SUPPORT_ANALYST_ENV=prd
SUPPORT_ANALYST_ALLOW_PRD=true
SUPPORT_ANALYST_CREDENTIAL_ENV=prd
SUPPORT_ANALYST_ENDPOINT_ENV=prd
SUPPORT_ANALYST_ES_URL=
SUPPORT_ANALYST_ES_API_KEY=
SUPPORT_ANALYST_RUNTIME_DIR=deploy/runtime/support-analyst-prd
SUPPORT_ANALYST_WATCH_ENABLED=true
SUPPORT_ANALYST_PUBLIC_URL=https://tap.quivercloud.com.br
# Opcional: link do Kibana PRD (Tailscale) nas mensagens [ANALISTA].
SUPPORT_ANALYST_KIBANA_URL=
# Minutos apos o boot do Windows sem alertar enquanto a rede/Tailscale sobe.
SUPPORT_ANALYST_BOOT_QUIET_MINUTES=10
# Opcional (TAP-169): chave so-escrita do batimento; criada por scripts/observability/setup-analyst-heartbeat.ps1.
# Precisa ser diferente da chave de leitura acima.
SUPPORT_ANALYST_REMOTE_HEARTBEAT_API_KEY=
# Opcional (TAP-180): o aviso "Nova versao no ar" lista PRs (API publica do GitHub) e o nome/estado/descricao
# dos WIs. Para os WIs, gere no Plane local uma chave de API so leitura e preencha abaixo; sem ela vai so o TAP-N.
SUPPORT_ANALYST_GITHUB_REPO=filipedsn/cervejaria
SUPPORT_ANALYST_PLANE_URL=http://127.0.0.1:8090
SUPPORT_ANALYST_PLANE_WORKSPACE=quiver
SUPPORT_ANALYST_PLANE_API_KEY=
SUPPORT_ANALYST_TELEGRAM_ENABLED=true
SUPPORT_ANALYST_TELEGRAM_DRY_RUN=true
SUPPORT_ANALYST_TELEGRAM_BOT_TOKEN=
SUPPORT_ANALYST_TELEGRAM_CHAT_ID=
# Resumo da jornada (--resumo) usa o Ollama local; sem ele, so a linha do tempo.
SUPPORT_ANALYST_LLM_ENABLED=false
SUPPORT_ANALYST_LLM_ENDPOINT=http://127.0.0.1:11434
