# Deixe vazio em dev (usa proxy do Vite — funciona no PC e no celular via IP local)
# VITE_API_URL=
# VITE_SOCKET_URL=

# Acesse no celular (mesma Wi-Fi): http://SEU_IP_LOCAL:5202
# O Vite expõe na rede (host: true). Reinicie com: npm run restart
# QR/links públicos usam o IP da LAN automaticamente; force com:
# VITE_PUBLIC_APP_URL=http://SEU_IP_LOCAL:5202
# Em produção:
# VITE_API_URL=https://app.seudominio.com.br
# VITE_SOCKET_URL=https://app.seudominio.com.br
