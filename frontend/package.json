{
  "name": "cervejaria-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner",
    "test:unit": "node --import ../scripts/node24-tsx-host.mjs --import ../backend/node_modules/tsx/dist/loader.mjs --test tests/quiosque.test.ts tests/quiosque-capacidades.test.ts tests/correlation-id.test.ts tests/auth-session.test.ts tests/onboarding.test.ts tests/onboarding-visual.test.ts",
    "build:deploy": "vite build --configLoader runner",
    "build:prod": "vite build --outDir ../deploy/prod-artifacts/.staging/frontend",
    "preview": "vite preview",
    "icons": "node scripts/generate-pwa-icons.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.68.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.4.0",
    "recharts": "^3.9.2",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.14",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vite-plugin-pwa": "^0.21.1"
  }
}
