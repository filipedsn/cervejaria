# Desenvolvimento â€” banco cervejaria_dev (testes locais, sem afetar producao)
DATABASE_URL="postgresql://cervejaria_dev:SENHA@localhost:5434/cervejaria_dev?schema=public"
MIGRATE_DATABASE_URL="postgresql://cervejaria:SENHA_OWNER@localhost:5434/cervejaria_dev?schema=public"
JWT_SECRET="dev-local-secret"
JWT_EXPIRES_IN="8h"
PORT=3002
HOST=0.0.0.0
CORS_ORIGIN="http://localhost:5202,https://tapdev.quivercloud.com.br"
APP_URL="https://tapdev.quivercloud.com.br"
UPLOADS_DIR="uploads-dev"

RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_FORGOT_MAX=5
RATE_LIMIT_WINDOW="1 minute"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Quiver Tap Alertas <contato@quivercloud.com.br>"

# Alertas Kibana -> e-mail (licenca Basic: connector .index + worker separado)
# KIBANA_ALERT_WEBHOOK_SECRET=gerar-uuid-seguro
# OBS_ALERT_EMAIL_TO=ops@seudominio.com.br
# Telegram via Bot oficial (@BotFather)
# OBS_ALERT_TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# OBS_ALERT_TELEGRAM_CHAT_ID=123456789
# KIBANA_ALERT_POLL_IN_API=false
# KIBANA_ALERT_POLL_ENABLED=true
# KIBANA_ALERT_ES_URL=http://127.0.0.1:9200
# KIBANA_ALERT_ES_INDEX=quiver-tap-alert-events
# KIBANA_ALERT_ES_API_KEY=   # ou ELASTIC_API_KEY_ALERT_POLLER em deploy/observability/.env.observability
# KIBANA_ALERT_ES_USER=elastic
# KIBANA_ALERT_ES_PASSWORD=  # ou ELASTIC_PASSWORD em .env.observability
# KIBANA_ALERT_POLL_INTERVAL_MS=30000
# KIBANA_ALERT_POLL_STATE_FILE=deploy/runtime/alert-poller-state.json
# ALERT_POLLER_HEALTH_PORT=3098

# OpenTelemetry / Elastic Observability (EDOT)
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=ApiKey SUA_CHAVE_AQUI
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
ELASTIC_OTEL_NODE_ENABLE_LOG_SENDING=true
OTEL_SERVICE_NAME=quiver-tap-api-dev
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development,service.version=1.0.0,service.instance.id=dev-local
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
# Intervalo de export de metricas (ms). 60000 evita volume excessivo vs prod (default ~10s).
OTEL_METRIC_EXPORT_INTERVAL=60000
# Host metrics do collector (hostmetrics receiver). Evita duplicata e version_conflict no ES.
OTEL_NODE_DISABLED_INSTRUMENTATIONS=host-metrics
AUDIT_SQL=true
AUDIT_SQL_SAMPLE_RATE=1
LOG_LEVEL=debug

# Web Push (alertas com app minimizado / tela bloqueada)
# Gere novas chaves com: node -e "import wp from 'web-push'; const k=wp.generateVAPIDKeys(); console.log(k)"
VAPID_PUBLIC_KEY="BPVvMEAPbseLhOejCi5j19_kerTMUTdSosp0LNFM_SWtIJEt7S75Py0rNIejzQbgnOIEMs93PrSuAfrvRAE5j_s"
VAPID_PRIVATE_KEY="B7dGV_KaZ2g9wOl1ZCv3hK4VpnxK-ZqUNbmpA29N-KY"
VAPID_SUBJECT="mailto:contato@quivercloud.com.br"

# Modelo de PDV unico (canonico) para todas as empresas. Toda empresa ativa precisa de
# 1 PDV ativo com configuracao; o prod:preflight bloqueia o deploy se houver excecao.
PDV_CANONICAL_ALL=1
