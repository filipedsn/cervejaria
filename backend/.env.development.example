# Desenvolvimento — banco cervejaria_dev (testes locais, sem afetar producao)
DATABASE_URL="postgresql://cervejaria_dev:SENHA@localhost:5432/cervejaria_dev?schema=public"
JWT_SECRET="dev-local-secret"
JWT_EXPIRES_IN="8h"
PORT=3002
HOST=0.0.0.0
CORS_ORIGIN="http://localhost:5202"
APP_URL="http://localhost:5202"
UPLOADS_DIR="uploads-dev"

RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_FORGOT_MAX=5
RATE_LIMIT_WINDOW="1 minute"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Cervejaria Movel <noreply@localhost>"

# OpenTelemetry / Elastic Observability (EDOT)
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=ApiKey SUA_CHAVE_AQUI
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
ELASTIC_OTEL_NODE_ENABLE_LOG_SENDING=true
OTEL_SERVICE_NAME=quiver-tap-api-dev
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development,service.version=1.0.0
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
AUDIT_SQL=true
AUDIT_SQL_SAMPLE_RATE=1
LOG_LEVEL=debug
