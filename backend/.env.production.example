# Producao — banco cervejaria (dados reais dos clientes)
DATABASE_URL="postgresql://cervejaria_prod:SENHA@localhost:5432/cervejaria?schema=public"
# Owner do schema (migrations ALTER TABLE) — use o superuser do Postgres, nao cervejaria_prod
MIGRATE_DATABASE_URL="postgresql://cervejaria:SENHA_OWNER@localhost:5432/cervejaria?schema=public"
JWT_SECRET="gere-um-segredo-longo-e-aleatorio"
JWT_EXPIRES_IN="8h"
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN="https://tap.quivercloud.com.br"
APP_URL="https://tap.quivercloud.com.br"
# Caminho relativo ao cwd da API. Em producao start-api.ps1 sobrescreve com caminho
# absoluto para backend/uploads-prod (fora de deploy/prod-artifacts).
UPLOADS_DIR="uploads-prod"

RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_FORGOT_MAX=5
RATE_LIMIT_WINDOW="1 minute"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Cervejaria Movel <noreply@seudominio.com.br>"

# Alertas Kibana -> webhook -> e-mail (worker separado; API nao faz poll por padrao)
# KIBANA_ALERT_WEBHOOK_SECRET=gerar-uuid-seguro
# OBS_ALERT_EMAIL_TO=ops@seudominio.com.br
# Telegram via Bot oficial (@BotFather)
# OBS_ALERT_TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# OBS_ALERT_TELEGRAM_CHAT_ID=123456789
# KIBANA_ALERT_POLL_IN_API=false
# KIBANA_ALERT_POLL_ENABLED=true
# KIBANA_ALERT_ES_URL=http://127.0.0.1:9200
# KIBANA_ALERT_ES_INDEX=quiver-tap-alert-events
# KIBANA_ALERT_POLL_INTERVAL_MS=30000
# KIBANA_ALERT_POLL_STATE_FILE=deploy/runtime/alert-poller-state.json
# ALERT_POLLER_HEALTH_PORT=3098

# OpenTelemetry / Elastic Observability (EDOT) / Elastic Observability (EDOT)
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=ApiKey SUA_CHAVE_AQUI
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
ELASTIC_OTEL_NODE_ENABLE_LOG_SENDING=true
OTEL_SERVICE_NAME=quiver-tap-api
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production,service.version=1.0.0
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
OTEL_METRIC_EXPORT_INTERVAL=60000
AUDIT_SQL=true
AUDIT_SQL_SAMPLE_RATE=0.05
LOG_LEVEL=info

# Traces: ~15% amostragem; métricas permanecem 100%
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.15
OTEL_NODE_DISABLED_INSTRUMENTATIONS=fs,dns,net

# Web Push (alertas com app minimizado / tela bloqueada)
VAPID_PUBLIC_KEY="gere-chave-publica-vapid"
VAPID_PRIVATE_KEY="gere-chave-privada-vapid"
VAPID_SUBJECT="mailto:contato@quivercloud.com.br"

# Modelo de PDV unico (canonico) para todas as empresas. Toda empresa ativa precisa de
# 1 PDV ativo com configuracao; o prod:preflight bloqueia o deploy se houver excecao.
PDV_CANONICAL_ALL=1
