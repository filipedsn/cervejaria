{
  "name": "cervejaria-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "postinstall": "prisma generate",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "node scripts/run-with-env.mjs development npx prisma migrate dev",
    "db:migrate:prod": "node scripts/run-with-env.mjs production npx prisma migrate deploy",
    "db:push": "node scripts/run-with-env.mjs development npx prisma db push",
    "db:seed": "node scripts/run-with-env.mjs development npx tsx prisma/seed.ts",
    "db:studio": "node scripts/run-with-env.mjs development npx prisma studio",
    "qa:setup": "tsx qa/setup.ts",
    "qa:suite": "tsx qa/suite.ts",
    "qa:worker": "tsx qa/worker.ts",
    "qa:report": "tsx qa/report.ts",
    "qa:teardown": "tsx qa/teardown.ts",
    "qa:test": "tsx qa/run.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^9.0.4",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "^8.1.0",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "cookie": "^2.0.1",
    "fastify": "^5.2.1",
    "nodemailer": "^6.10.1",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "prisma": {
    "seed": "node scripts/run-with-env.mjs development npx tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^6.4.24",
    "prisma": "^6.5.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
