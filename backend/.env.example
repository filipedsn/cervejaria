# Ambientes separados — copie os exemplos e ajuste:
#
#   cp .env.development.example .env.development   (banco cervejaria_dev, localhost)
#   cp .env.production.example  .env.production    (banco cervejaria, tap.quivercloud.com.br)
#
# O arquivo .env legado nao e mais usado. Desenvolvimento carrega .env.development;
# producao carrega .env.production (NODE_ENV=production).
