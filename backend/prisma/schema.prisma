generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "quiosque"]
}

enum UserRole {
  ADMIN
  DONO
  ATENDENTE

  @@schema("public")
}

enum EventStatus {
  ABERTO
  FECHADO

  @@schema("public")
}

enum ComandaStatus {
  ABERTA
  FECHADA
  CANCELADA

  @@schema("public")
}

enum ComandaTipo {
  COMANDA
  AVULSA

  @@schema("public")
}

enum PaymentMethod {
  DINHEIRO
  PIX
  CARTAO
  CARTAO_DEBITO
  CARTAO_CREDITO

  @@schema("public")
}

enum ProdutoTipo {
  BEBIDA
  COMIDA

  @@schema("public")
}

enum FormatoBebida {
  CHOPE
  LATA
  LONGNECK
  GARRAFA
  OUTRO

  @@schema("public")
}

enum TransacaoTipo {
  COMANDA_CRIADA
  COMANDA_ITEM_ADICIONADO
  COMANDA_ITEM_REMOVIDO
  COMANDA_FECHADA
  COMANDA_CANCELADA
  EVENTO_CRIADO
  EVENTO_SESSAO_INICIADA
  EVENTO_ATUALIZADO
  EVENTO_FECHADO
  EVENTO_REABERTO
  EVENTO_EXCLUIDO
  EVENTO_CARDAPIO_ATUALIZADO
  TAP_CHOPE_POSICIONADO
  TAP_CHOPE_REMOVIDO
  TAP_ATIVO_ALTERADO
  QUIOSQUE_CAIXA_ABERTO
  QUIOSQUE_CAIXA_MOVIMENTO
  QUIOSQUE_CAIXA_FECHADO
  QUIOSQUE_COMANDA_CRIADA
  QUIOSQUE_COMANDA_FECHADA
  QUIOSQUE_COMANDA_CANCELADA
  QUIOSQUE_PEDIDO_CRIADO
  QUIOSQUE_PAGAMENTO_REGISTRADO
  QUIOSQUE_COMANDA_GRUPO_FECHADO
  QUIOSQUE_PEDIDO_COZINHA
  QUIOSQUE_ESTOQUE_MOVIMENTO
  QUIOSQUE_DESCONTO_APLICADO
  QUIOSQUE_VENDA_AVULSA
  PORTAL_PEDIDO_CRIADO
  PORTAL_PEDIDO_RECUSADO

  @@schema("public")
}

enum CadastroOrigem {
  STAFF
  AUTO_ATENDIMENTO
  COMANDA

  @@schema("public")
}

enum PedidoClienteStatus {
  PENDENTE
  CONFIRMADO
  RECUSADO
  CANCELADO

  @@schema("public")
}

model Cervejaria {
  id          String   @id @default(cuid())
  nome        String
  slug        String   @unique
  ativo       Boolean  @default(true)
  logoUrl     String?
  corPrimaria String?
  corPaleta   Json?
  /** KPIs da tela de comandas (cervejaria e quiosque). */
  exibirKpisComanda Boolean @default(true)
  /** Lista de comandas em coluna única (ligado) ou duas colunas (desligado). */
  comandasColunaUnica Boolean @default(true)
  /** Cardápios com preço por evento (ligado) ou só catálogo tradicional (desligado). */
  usaCardapio Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  usuarios Usuario[]
  produtos Produto[]
  trailers Trailer[]
  taps     Tap[]
  eventos  Evento[]
  clientes Cliente[]
  cardapios Cardapio[]
  transacoes TransacaoLog[]
  eventoSerieExclusoes EventoSerieExclusao[]

  configuracaoQuiosque ConfiguracaoQuiosque?
  pontosVenda          PontoVenda[]
  produtosQuiosque     ProdutoQuiosque[]
  cardapiosQuiosque    CardapioQuiosque[]
  comandasQuiosque     ComandaQuiosque[]
  pedidosQuiosque      PedidoQuiosque[]
  sessoesCaixaQuiosque SessaoCaixaQuiosque[]
  saldosEstoqueQuiosque EstoqueSaldoQuiosque[]
  movimentosEstoqueQuiosque MovimentoEstoqueQuiosque[]

  @@schema("public")
}

model Trailer {
  id            String   @id @default(cuid())
  nome          String
  identificador String?
  ativo         Boolean  @default(true)
  cervejariaId  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cervejaria Cervejaria @relation(fields: [cervejariaId], references: [id], onDelete: Cascade)
  taps       Tap[]
  eventos    Evento[]

  @@index([cervejariaId])

  @@schema("public")
}

model Usuario {
  id                 String    @id @default(cuid())
  nome               String
  email              String    @unique
  senhaHash          String
  papel              UserRole  @default(ATENDENTE)
  /// Autoriza aplicar desconto manual em comandas do quiosque. Dono sempre pode.
  podeDarDescontoQuiosque Boolean @default(false)
  cervejariaId       String?
  passwordChangedAt  DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  cervejaria            Cervejaria?           @relation(fields: [cervejariaId], references: [id], onDelete: Cascade)
  passwordResetTokens   PasswordResetToken[]
  comandasFechadas      Comanda[]             @relation("ComandaFechadaPor")
  pedidosConfirmados    PedidoCliente[]       @relation("PedidoConfirmadoPor")
  transacoes            TransacaoLog[]
  pushSubscriptions     PushSubscription[]

  @@index([cervejariaId])

  @@schema("public")
}

model PushSubscription {
  id        String   @id @default(cuid())
  usuarioId String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, endpoint])
  @@index([usuarioId])

  @@schema("public")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  usuarioId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])

  @@schema("public")
}

model Produto {
  id           String      @id @default(cuid())
  nome         String
  descricao    String?
  cor          String?
  estilo       String?
  tipo         ProdutoTipo   @default(BEBIDA)
  formato      FormatoBebida?
  ativo        Boolean       @default(true)
  cervejariaId String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  cervejaria Cervejaria @relation(fields: [cervejariaId], references: [id], onDelete: Cascade)
  precos     Preco[]
  taps       Tap[]
  montagens  TapMontagem[]
  itens      ItemComanda[]
  pedidoItens PedidoClienteItem[]
  eventos    EventoProduto[]
  cardapios  CardapioProduto[]

  @@index([cervejariaId])

  @@schema("public")
}

model Preco {
  id        String  @id @default(cuid())
  produtoId String
  volumeMl  Int
  preco     Decimal @db.Decimal(10, 2)

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([produtoId, volumeMl])

  @@schema("public")
}

model Tap {
  id           String  @id @default(cuid())
  numero       Int
  nome         String?
  produtoId    String?
  ativo        Boolean @default(true)
  cervejariaId String
  trailerId    String

  produto    Produto?      @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  cervejaria Cervejaria    @relation(fields: [cervejariaId], references: [id], onDelete: Cascade)
  trailer    Trailer       @relation(fields: [trailerId], references: [id], onDelete: Cascade)
  montagens  TapMontagem[]
  itens      ItemComanda[]

  @@unique([trailerId, numero])
  @@index([cervejariaId])
  @@index([trailerId])

  @@schema("public")
}

/// Chope posicionado em um tap durante um evento (histórico de trocas no dia).
model TapMontagem {
  id          String    @id @default(cuid())
  tapId       String
  produtoId   String
  eventoId    String
  iniciadoEm  DateTime  @default(now())
  encerradoEm DateTime?

  tap     Tap     @relation(fields: [tapId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  evento  Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@index([eventoId, encerradoEm])
  @@index([tapId, eventoId])

  @@schema("public")
}

enum RecorrenciaTipo {
  NENHUMA
  SEMANAL

  @@schema("public")
}

model Evento {
  id           String          @id @default(cuid())
  nome         String
  local        String
  data         DateTime?       @db.Date
  horaInicio   String          @default("18:00")
  horaFim      String?
  recorrencia  RecorrenciaTipo @default(NENHUMA)
  diaSemana    Int?
  serieId      String?
  status           EventStatus     @default(ABERTO)
  encerradoEm      DateTime?
  /// Reinicia o numerador de comandas ao reabrir o evento.
  comandasContadorDesde DateTime      @default(now())
  portalGeneration Int             @default(0)
  cervejariaId     String
  trailerId    String
  cardapioId   String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  cervejaria  Cervejaria @relation(fields: [cervejariaId], references: [id], onDelete: Cascade)
  trailer     Trailer    @relation(fields: [trailerId], references: [id], onDelete: Restrict)
  cardapio    Cardapio?  @relation(fields: [cardapioId], references: [id], onDelete: SetNull)
  serie       Evento?    @relation("SerieOcorrencias", fields: [serieId], references: [id], onDelete: SetNull)
  ocorrencias Evento[] @relation("SerieOcorrencias")
  agendamentoExclusoes EventoSerieExclusao[] @relation("SerieAgendamentoExclusoes")
  comandas    Comanda[]
  pedidos     PedidoCliente[]
  montagens   TapMontagem[]
  produtos    EventoProduto[]
  transacoes  TransacaoLog[]

  @@unique([serieId, data])
  @@index([cervejariaId, status])
  @@index([cervejariaId, recorrencia])
  @@index([trailerId])
  @@index([cardapioId])

  @@schema("public")
}

/// Ocorrência cancelada de uma agenda fixa semanal (pula um dia específico).
model EventoSerieExclusao {
  id           String   @id @default(cuid())
  serieId      String
  data         DateTime @db.Date
  cervejariaId String
  createdAt    DateTime @default(now())

  serie      Evento     @relation("SerieAgendamentoExclusoes", fields: [serieId], references: [id], onDelete: Cascade)
  cervejaria Cervejaria @relation(fields: [cervejariaId], references: [id], onDelete: Cascade)

  @@unique([serieId, data])
  @@index([cervejariaId])

  @@schema("public")
}

/// Cardápio reutilizável (comida e bebidas, sem chope).
model Cardapio {
  id           String   @id @default(cuid())
  nome         String
  ativo        Boolean  @default(true)
  cervejariaId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cervejaria Cervejaria       @relation(fields: [cervejariaId], references: [id], onDelete: Cascade)
  produtos   CardapioProduto[]
  eventos    Evento[]

  @@index([cervejariaId])

  @@schema("public")
}

model CardapioProduto {
  id         String  @id @default(cuid())
  cardapioId String
  produtoId  String
  precoUnit  Decimal @db.Decimal(10, 2)

  cardapio Cardapio @relation(fields: [cardapioId], references: [id], onDelete: Cascade)
  produto  Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([cardapioId, produtoId])
  @@index([cardapioId])

  @@schema("public")
}

model Cliente {
  id               String          @id @default(cuid())
  nome             String
  telefone         String?
  email            String?
  dataNascimento   DateTime?
  optInMarketing   Boolean         @default(false)
  optInEm          DateTime?
  cadastradoVia    CadastroOrigem  @default(COMANDA)
  observacoes      String?
  ativo            Boolean         @default(true)
  isSistema        Boolean         @default(false)
  cervejariaId     String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  cervejaria    Cervejaria           @relation(fields: [cervejariaId], references: [id], onDelete: Cascade)
  comandas      Comanda[]
  pedidos       PedidoCliente[]
  estatisticas  ClienteEstatisticas?

  @@unique([cervejariaId, telefone])
  @@index([cervejariaId, nome])
  @@index([cervejariaId, ativo])

  @@schema("public")
}

/// Agregados de consumo — extensível para fidelização (pontos) no futuro.
model ClienteEstatisticas {
  clienteId              String   @id
  totalComandasFechadas  Int      @default(0)
  totalGasto             Decimal  @default(0) @db.Decimal(12, 2)
  totalMlChope           Int      @default(0)
  primeiraVisitaEm       DateTime?
  ultimaVisitaEm         DateTime?
  updatedAt              DateTime @updatedAt

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model Comanda {
  id           String        @id @default(cuid())
  eventoId     String
  clienteId    String
  status       ComandaStatus @default(ABERTA)
  tipo         ComandaTipo   @default(COMANDA)
  /// Sequencial da comanda dentro do evento (vendas avulsas ficam sem numero).
  numero       Int?
  total        Decimal       @default(0) @db.Decimal(10, 2)
  fechadoPorId String?
  fechadaEm    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  evento     Evento    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  cliente    Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  fechadoPor Usuario?  @relation("ComandaFechadaPor", fields: [fechadoPorId], references: [id], onDelete: SetNull)
  itens      ItemComanda[]
  pagamentos Pagamento[]
  pedidos    PedidoCliente[]
  transacoes TransacaoLog[]

  @@index([eventoId, status])
  @@index([eventoId, status, tipo])
  @@index([fechadoPorId])

  @@schema("public")
}

model ItemComanda {
  id         String   @id @default(cuid())
  comandaId  String
  produtoId  String
  tapId      String?
  volumeMl   Int
  quantidade Int      @default(1)
  precoUnit  Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  comanda Comanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  tap     Tap?    @relation(fields: [tapId], references: [id], onDelete: SetNull)

  @@index([comandaId])
  @@index([tapId])

  @@schema("public")
}

model PedidoCliente {
  id              String              @id @default(cuid())
  eventoId        String
  comandaId       String
  clienteId       String
  status          PedidoClienteStatus @default(PENDENTE)
  observacao      String?
  recusadoMotivo  String?
  confirmadoPorId String?
  confirmadoEm    DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  evento        Evento              @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  comanda       Comanda             @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  cliente       Cliente             @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  confirmadoPor Usuario?            @relation("PedidoConfirmadoPor", fields: [confirmadoPorId], references: [id], onDelete: SetNull)
  itens         PedidoClienteItem[]

  @@index([eventoId, status])
  @@index([comandaId])
  @@index([clienteId])

  @@schema("public")
}

model PedidoClienteItem {
  id         String  @id @default(cuid())
  pedidoId   String
  produtoId  String
  tapId      String?
  volumeMl   Int
  quantidade Int     @default(1)
  precoUnit  Decimal @db.Decimal(10, 2)

  pedido  PedidoCliente @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto       @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([pedidoId])

  @@schema("public")
}

/// Comida e bebidas (não chope) disponíveis no evento — definido antes de abrir.
model EventoProduto {
  id        String   @id @default(cuid())
  eventoId  String
  produtoId String
  createdAt DateTime @default(now())

  evento  Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([eventoId, produtoId])
  @@index([eventoId])

  @@schema("public")
}

model Pagamento {
  id        String        @id @default(cuid())
  comandaId String
  forma     PaymentMethod
  valor     Decimal       @db.Decimal(10, 2)
  pagoEm    DateTime      @default(now())

  comanda Comanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)

  @@index([comandaId])

  @@schema("public")
}

model TransacaoLog {
  id           String        @id @default(cuid())
  cervejariaId String
  tipo         TransacaoTipo
  usuarioId    String?
  eventoId     String?
  comandaId    String?
  entidadeTipo String?
  entidadeId   String?
  metadata     Json          @default("{}")
  createdAt    DateTime      @default(now())

  cervejaria Cervejaria @relation(fields: [cervejariaId], references: [id], onDelete: Cascade)
  usuario    Usuario?   @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  evento     Evento?    @relation(fields: [eventoId], references: [id], onDelete: SetNull)
  comanda    Comanda?   @relation(fields: [comandaId], references: [id], onDelete: SetNull)

  @@index([cervejariaId, createdAt])
  @@index([eventoId, createdAt])
  @@index([comandaId, createdAt])
  @@index([tipo])

  @@schema("public")
}

model SystemConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@schema("public")
}

// ---------------------------------------------------------------------------
// Modulo Quiosque — schema proprio, isolado da operacao de cervejaria.
// Compartilha apenas Cervejaria (cadastro da empresa) e Usuario (autenticacao).
// ---------------------------------------------------------------------------

/// Ativa o modulo Quiosque para uma empresa. A existencia da linha e o que liga
/// o modulo, evitando qualquer coluna nova nas tabelas da cervejaria.
model ConfiguracaoQuiosque {
  cervejariaId    String   @id
  ativo           Boolean  @default(true)
  controlaEstoque Boolean  @default(false)
  temCozinha      Boolean  @default(false)
  /// Empresa que so opera quiosque. Esconde as telas de cervejaria sem precisar
  /// de nenhuma coluna nova no schema public.
  exclusivo       Boolean  @default(false)
  /// Cardápios com preço por turno (ligado) ou só catálogo tradicional (desligado).
  usaCardapio     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cervejaria Cervejaria @relation(fields: [cervejariaId], references: [id], onDelete: Cascade)

  @@schema("quiosque")
}

/// Quiosque fisico. Uma empresa pode ter varios.
model PontoVenda {
  id           String   @id @default(cuid())
  cervejariaId String
  nome         String
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cervejaria Cervejaria          @relation(fields: [cervejariaId], references: [id], onDelete: Cascade)
  comandas   ComandaQuiosque[]
  pedidos    PedidoQuiosque[]
  sessoesCaixa SessaoCaixaQuiosque[]
  saldosEstoque EstoqueSaldoQuiosque[]
  movimentosEstoque MovimentoEstoqueQuiosque[]

  @@index([cervejariaId, ativo])
  @@schema("quiosque")
}

/// Catalogo proprio do quiosque, sem volume e sem tap: o produto e vendido por
/// unidade. Separado de Produto para nao carregar as regras de chope.
model ProdutoQuiosque {
  id              String   @id @default(cuid())
  cervejariaId    String
  nome            String
  categoria       String?
  precoUnit       Decimal  @db.Decimal(10, 2)
  exigePreparo    Boolean  @default(false)
  controlaEstoque Boolean  @default(true)
  ativo           Boolean  @default(true)
  ordem           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cervejaria Cervejaria           @relation(fields: [cervejariaId], references: [id], onDelete: Cascade)
  itens      ItemPedidoQuiosque[]
  saldosEstoque EstoqueSaldoQuiosque[]
  movimentosEstoque MovimentoEstoqueQuiosque[]
  cardapios  CardapioQuiosqueProduto[]
  sessoesCaixa SessaoCaixaProdutoQuiosque[]

  @@index([cervejariaId, ativo, ordem])
  @@schema("quiosque")
}

/// Templates reutilizaveis de cardapio do quiosque (espelha Cardapio da cervejaria).
model CardapioQuiosque {
  id           String   @id @default(cuid())
  nome         String
  ativo        Boolean  @default(true)
  cervejariaId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cervejaria Cervejaria                @relation(fields: [cervejariaId], references: [id], onDelete: Cascade)
  produtos   CardapioQuiosqueProduto[]
  sessoes    SessaoCaixaQuiosque[]

  @@index([cervejariaId])
  @@schema("quiosque")
}

model CardapioQuiosqueProduto {
  id                String  @id @default(cuid())
  cardapioId        String
  produtoQuiosqueId String
  precoUnit         Decimal @db.Decimal(10, 2)

  cardapio CardapioQuiosque @relation(fields: [cardapioId], references: [id], onDelete: Cascade)
  produto  ProdutoQuiosque  @relation(fields: [produtoQuiosqueId], references: [id], onDelete: Cascade)

  @@unique([cardapioId, produtoQuiosqueId])
  @@index([cardapioId])
  @@schema("quiosque")
}

enum TipoComandaQuiosque {
  /// Venda paga na hora, sem conta aberta.
  AVULSA
  APELIDO
  MESA
  FICHA

  @@schema("quiosque")
}

enum StatusComandaQuiosque {
  ABERTA
  FECHADA
  CANCELADA

  @@schema("quiosque")
}

enum StatusPedidoQuiosque {
  RECEBIDO
  EM_PREPARO
  PRONTO
  ENTREGUE
  CANCELADO

  @@schema("quiosque")
}

enum FormaPagamentoQuiosque {
  DINHEIRO
  PIX
  CARTAO_DEBITO
  CARTAO_CREDITO

  @@schema("quiosque")
}

/// Conta do cliente. A venda avulsa tambem vira comanda (tipo AVULSA), aberta e
/// fechada na mesma transacao, para que caixa e historico tenham um lugar so.
model ComandaQuiosque {
  id             String                @id @default(cuid())
  cervejariaId   String
  pontoVendaId   String
  tipo           TipoComandaQuiosque
  /// Apelido, numero da mesa ou da ficha. Nulo na venda avulsa.
  identificador  String?
  /// Sequencial da comanda no turno de caixa (vendas avulsas ficam sem numero).
  numero         Int?
  status         StatusComandaQuiosque @default(ABERTA)
  /// Dia da operacao em America/Sao_Paulo. O quiosque vira a noite, entao a data
  /// civil do instante UTC nao serve para fechar o caixa.
  diaOperacional DateTime              @db.Date
  /// Referencias de usuario ficam por id, sem relation, para nao espalhar o
  /// modulo dentro do modelo Usuario.
  abertaPorId    String
  fechadaPorId   String?
  fechadaEm      DateTime?
  /// Desconto manual aplicado na comanda (valor absoluto em reais).
  desconto       Decimal               @default(0) @db.Decimal(10, 2)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  cervejaria Cervejaria          @relation(fields: [cervejariaId], references: [id], onDelete: Cascade)
  pontoVenda PontoVenda          @relation(fields: [pontoVendaId], references: [id], onDelete: Restrict)
  pedidos    PedidoQuiosque[]
  pagamentos PagamentoQuiosque[]

  @@index([cervejariaId, status, createdAt])
  @@index([cervejariaId, diaOperacional])
  @@index([pontoVendaId, status])
  @@schema("quiosque")
}

/// Uma rodada de itens dentro da comanda. E a unidade que a cozinha ve na fila.
model PedidoQuiosque {
  id             String               @id @default(cuid())
  cervejariaId   String
  comandaId      String
  pontoVendaId   String
  /// Senha mostrada ao cliente, reiniciada a cada dia de operacao.
  numero         Int
  diaOperacional DateTime             @db.Date
  status         StatusPedidoQuiosque @default(RECEBIDO)
  observacao     String?
  criadoPorId    String
  /// Inicio do status atual — o cronometro da cozinha reinicia a cada transicao.
  statusDesde    DateTime             @default(now())
  /// Preenchido ao marcar ENTREGUE; congela o tempo total do pedido.
  entregueEm     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  cervejaria Cervejaria           @relation(fields: [cervejariaId], references: [id], onDelete: Cascade)
  comanda    ComandaQuiosque      @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  pontoVenda PontoVenda           @relation(fields: [pontoVendaId], references: [id], onDelete: Restrict)
  itens      ItemPedidoQuiosque[]
  movimentosEstoque MovimentoEstoqueQuiosque[]
  historicoStatus   PedidoQuiosqueStatusHistorico[]

  @@unique([cervejariaId, diaOperacional, numero])
  @@index([cervejariaId, status, createdAt])
  @@index([comandaId])
  @@schema("quiosque")
}

/// Marca cada transicao de status na fila da cozinha (auditoria e tempos por fase).
model PedidoQuiosqueStatusHistorico {
  id           String               @id @default(cuid())
  pedidoId     String
  status       StatusPedidoQuiosque
  registradoEm DateTime             @default(now())

  pedido PedidoQuiosque @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId, registradoEm])
  @@schema("quiosque")
}

model ItemPedidoQuiosque {
  id           String  @id @default(cuid())
  pedidoId     String
  produtoId    String
  /// Nome e preco sao copiados na venda: mexer no catalogo depois nao pode
  /// reescrever o que o cliente pagou.
  nome         String
  precoUnit    Decimal @db.Decimal(10, 2)
  quantidade   Int
  exigePreparo Boolean @default(false)

  pedido  PedidoQuiosque  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto ProdutoQuiosque @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([pedidoId])
  @@schema("quiosque")
}

model PagamentoQuiosque {
  id              String                 @id @default(cuid())
  comandaId       String
  forma           FormaPagamentoQuiosque
  valor           Decimal                @db.Decimal(10, 2)
  /// So no dinheiro: quanto o cliente entregou e quanto voltou de troco.
  valorRecebido   Decimal?               @db.Decimal(10, 2)
  troco           Decimal?               @db.Decimal(10, 2)
  registradoPorId String
  pagoEm          DateTime               @default(now())

  comanda ComandaQuiosque @relation(fields: [comandaId], references: [id], onDelete: Cascade)

  @@index([comandaId])
  @@schema("quiosque")
}

enum StatusCaixaQuiosque {
  ABERTO
  FECHADO

  @@schema("quiosque")
}

enum TipoMovimentoCaixaQuiosque {
  SANGRIA
  SUPRIMENTO

  @@schema("quiosque")
}

/// Sessao de caixa por turno: o mesmo ponto pode abrir/fechar varias vezes no dia.
model SessaoCaixaQuiosque {
  id             String              @id @default(cuid())
  cervejariaId   String
  pontoVendaId   String
  diaOperacional DateTime            @db.Date
  status         StatusCaixaQuiosque @default(ABERTO)
  trocoInicial   Decimal             @db.Decimal(10, 2)
  abertoPorId    String
  abertoEm       DateTime            @default(now())
  fechadoPorId   String?
  fechadoEm      DateTime?
  /// Conferencia fisica no fechamento. Nulo enquanto o caixa esta aberto.
  contadoDinheiro    Decimal? @db.Decimal(10, 2)
  contadoPix         Decimal? @db.Decimal(10, 2)
  contadoCartaoDebito  Decimal? @db.Decimal(10, 2)
  contadoCartaoCredito Decimal? @db.Decimal(10, 2)
  observacaoFechamento String?
  /// Template usado na abertura do turno (referencia historica).
  cardapioQuiosqueId   String?

  cervejaria  Cervejaria               @relation(fields: [cervejariaId], references: [id], onDelete: Cascade)
  pontoVenda  PontoVenda               @relation(fields: [pontoVendaId], references: [id], onDelete: Restrict)
  cardapio    CardapioQuiosque?        @relation(fields: [cardapioQuiosqueId], references: [id], onDelete: SetNull)
  movimentos  MovimentoCaixaQuiosque[]
  produtos    SessaoCaixaProdutoQuiosque[]

  @@index([pontoVendaId, diaOperacional, status])
  @@index([cervejariaId, diaOperacional])
  @@index([cardapioQuiosqueId])
  @@schema("quiosque")
}

/// Cardapio operacional do turno de caixa (espelha EventoProduto).
model SessaoCaixaProdutoQuiosque {
  id               String   @id @default(cuid())
  sessaoCaixaId    String
  produtoQuiosqueId String
  createdAt        DateTime @default(now())

  sessao  SessaoCaixaQuiosque @relation(fields: [sessaoCaixaId], references: [id], onDelete: Cascade)
  produto ProdutoQuiosque     @relation(fields: [produtoQuiosqueId], references: [id], onDelete: Cascade)

  @@unique([sessaoCaixaId, produtoQuiosqueId])
  @@index([sessaoCaixaId])
  @@schema("quiosque")
}

model MovimentoCaixaQuiosque {
  id              String                     @id @default(cuid())
  sessaoId        String
  tipo            TipoMovimentoCaixaQuiosque
  valor           Decimal                    @db.Decimal(10, 2)
  observacao      String?
  registradoPorId String
  createdAt       DateTime                   @default(now())

  sessao SessaoCaixaQuiosque @relation(fields: [sessaoId], references: [id], onDelete: Cascade)

  @@index([sessaoId])
  @@schema("quiosque")
}

enum TipoMovimentoEstoqueQuiosque {
  ENTRADA
  SAIDA_VENDA
  ESTORNO_VENDA
  PERDA
  CORTESIA
  CONSUMO_INTERNO
  AJUSTE

  @@schema("quiosque")
}

/// Saldo materializado por ponto de venda e produto.
model EstoqueSaldoQuiosque {
  id           String   @id @default(cuid())
  cervejariaId String
  pontoVendaId String
  produtoId    String
  quantidade   Int      @default(0)
  updatedAt    DateTime @updatedAt

  cervejaria Cervejaria     @relation(fields: [cervejariaId], references: [id], onDelete: Cascade)
  pontoVenda PontoVenda     @relation(fields: [pontoVendaId], references: [id], onDelete: Cascade)
  produto    ProdutoQuiosque @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([pontoVendaId, produtoId])
  @@index([cervejariaId, pontoVendaId])
  @@schema("quiosque")
}

model MovimentoEstoqueQuiosque {
  id              String                       @id @default(cuid())
  cervejariaId    String
  pontoVendaId    String
  produtoId       String
  tipo            TipoMovimentoEstoqueQuiosque
  quantidade      Int
  observacao      String?
  registradoPorId String
  pedidoId        String?
  createdAt       DateTime                     @default(now())

  cervejaria Cervejaria      @relation(fields: [cervejariaId], references: [id], onDelete: Cascade)
  pontoVenda PontoVenda      @relation(fields: [pontoVendaId], references: [id], onDelete: Cascade)
  produto    ProdutoQuiosque @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  pedido     PedidoQuiosque? @relation(fields: [pedidoId], references: [id], onDelete: SetNull)

  @@index([pontoVendaId, produtoId, createdAt])
  @@index([pedidoId])
  @@schema("quiosque")
}
